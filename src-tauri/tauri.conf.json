{
  "productName": "API Vault",
  "version": "1.0.0",
  "identifier": "com.apivault.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "API Vault", "width": 1180, "height": 760, "minWidth": 860, "minHeight": 580, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
